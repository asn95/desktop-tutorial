# ── Database ────────────────────────────────────────────────────────────────
# Kosongkan untuk memakai SQLite lokal (c3mr.db). Produksi memakai PostgreSQL.
DATABASE_URL=

# ── Autentikasi ─────────────────────────────────────────────────────────────
# Kunci penandatangan JWT. Wajib diisi, dan jangan dipakai ulang antar lingkungan.
JWT_SECRET=

# ── CORS ────────────────────────────────────────────────────────────────────
# Daftar origin yang diizinkan, dipisah koma.
CORS_ORIGINS=

# ── Telegram ────────────────────────────────────────────────────────────────
# Token bot dari BotFather. Dipakai untuk notifikasi, perintah bot, dan
# verifikasi HMAC initData dari Mini App petugas.
TELEGRAM_BOT_TOKEN=
# URL publik Mini App petugas, dipasang sebagai tombol di pesan Telegram.
MINI_APP_URL=
# Telegram ID tambahan yang boleh memakai perintah manajer, dipisah koma. Opsional.
MANAGER_BOT_ALLOWED_IDS=

# ── Asisten AI ──────────────────────────────────────────────────────────────
# WAJIB, dan harus diset di KEDUA service: asisten web berjalan di c3mr-app,
# sedangkan perintah /ask berjalan di c3mr-bot. Tanpa ini keduanya gagal.
ANTHROPIC_API_KEY=
# Model yang dipakai agen. Kosongkan untuk memakai default (claude-haiku-4-5).
AGENT_MODEL=

# ── Bootstrap administrator ─────────────────────────────────────────────────
# Hanya untuk membuat administrator PERTAMA pada pemasangan baru. Endpoint seed
# menolak berjalan begitu sudah ada manajer, jadi ini bukan jalur reset kata
# sandi. Opsional; biarkan kosong setelah admin pertama dibuat.
SEED_TOKEN=

# ── Lainnya ─────────────────────────────────────────────────────────────────
# false di produksi. true melewati beberapa pemeriksaan untuk pengembangan lokal.
DEBUG=false

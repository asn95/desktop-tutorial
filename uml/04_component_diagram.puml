@startuml
skinparam defaultFontName Arial

package "Client (Web + Telegram)" {
  class "Dashboard_View" as Dash
  class "TaskList_View" as TaskList
  class "ReportForm_View" as ReportForm
  class "Manager_Bot" as Bot
}

package "Backend (FastAPI)" {
  class "Target_Controller" as TCtrl
  class "Report_Controller" as RCtrl
  class "Notification_Service" as Notif
  class "Summary_Controller" as SCtrl
  class "Pydantic_Validator" as Validator
}

package "External" {
  class "Telegram_Bot_API" as TgAPI
}

package "Database (Supabase)" {
  class "DB_Client" as DbClient
  class "Storage_Client" as StorageClient
}

Dash ..> TCtrl : HTTP GET
TaskList ..> TCtrl : HTTP GET
ReportForm ..> RCtrl : HTTP POST
RCtrl --> Validator : validate()
RCtrl --> DbClient : INSERT report
RCtrl --> StorageClient : upload()
RCtrl --> Notif : trigger()
TCtrl --> DbClient : query()
Notif --> TgAPI : sendMessage()
TgAPI ..> Bot : push notification
Bot ..> TgAPI : /summary
TgAPI ..> SCtrl : webhook
SCtrl --> DbClient : aggregate()
@enduml
